# Copy to .env and fill in. .env is never committed and never baked into an image.

# The hostname Caddy serves and requests a certificate for. Use `localhost` for local runs.
SITE_ADDRESS=sheets.example.com

# Signs session cookies and the verification / password-reset tokens.
# Generate with: openssl rand -hex 32
SECRET=change-me

POSTGRES_USER=heroforge
POSTGRES_PASSWORD=change-me
POSTGRES_DB=heroforge

# Where the nightly pg_dump lands on the host.
BACKUP_DIR=./backups

# Set to false only when serving over plain HTTP locally.
COOKIE_SECURE=true

# Email verification before first login. Leave on in any deployment.
VERIFICATION_REQUIRED=true

# Without an SMTP host, verification and reset messages are logged instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
