# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Node
node_modules/
.vite/
web/dist/
# TypeScript's incremental build cache. It is a build artifact and its churn is noise in a diff.
web/tsconfig.tsbuildinfo
# An `npm install` run from the wrong working directory leaves this behind.
web/web/

# Environment / secrets
.env
.env.*
!.env.example

# Test artifacts
.coverage
htmlcov/
playwright-report/
test-results/

# OS
.DS_Store

# Playwright
web/test-results/
.playwright-mcp/

# Database dumps. `backups/` is where the nightly pg_dump lands, so it holds real account rows —
# addresses, password hashes, characters. Nothing in it may ever reach a commit.
backups/
*.sql
*.sql.gz

# Screenshots taken while working on the interface. Kept out of the tree at the root; anything
# genuinely part of the application lives under web/public/ or docs/.
/*.png
